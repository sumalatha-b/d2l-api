		<ee:transform doc:name="D2LUpdateRequest" doc:id="87d5342c-fd9a-4aea-b215-c89271eeed98" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
    "FirstName": payload.FirstName__c,
    "MiddleName": payload.MiddleName__c default "",
    "LastName": payload.LastName__c,
    "UserName": payload.Name,
    "ExternalEmail": payload.ExternalEmail__c default "",
    "OrgDefinedId": payload.OrgDefinedId__c,
    "UniqueIdentifier": payload.UniqueIdentifier__c,
    "Activation": {
        "IsActive": payload.IsActive__c default true
    },
    "DisplayName": payload.DisplayName__c default "",
    "LastAccessedDate": payload.LastModifiedDate default "",
    "Pronouns": payload.Pronouns__c default ""
}]]></ee:set-payload>
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="userId" ><![CDATA[%dw 2.0
output application/json
---
payload.UserId__c as Number]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<logger level="INFO" doc:name="D2L Request Logger" doc:id="9fb91bf6-d78e-41da-92bb-d920f853b339" message="#[payload]" />
