			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
[{
	OrgDefinedId__c: vars.userResponse.OrgDefinedId,
	Name: vars.userResponse.UserName,
	UserId__c: vars.userResponse.UserId,
	UniqueIdentifier__c: vars.userResponse.UniqueIdentifier,
	OrgId__c: vars.userResponse.OrgId,
	DisplayName__c: vars.userResponse.DisplayName
}]]]></ee:set-payload>
			</ee:message>
