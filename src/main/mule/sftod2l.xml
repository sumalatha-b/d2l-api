		<ee:transform doc:name="D2LCreateRequest" doc:id="8bbaf7c0-3261-49b6-92de-01c711441cb2" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  "OrgDefinedId": payload.OrgDefinedId__c default "",
  "FirstName": payload.FirstName__c default "",
  "MiddleName": payload.MiddleName__c default "",
  "LastName": payload.LastName__c default "",
  "ExternalEmail": payload.ExternalEmail__c default "",
  "UserName": payload.Name default "",
  "RoleId": payload.RoleId__c as Number default 1,
  "IsActive": payload.IsActive__c as Boolean default true,
  "SendCreationEmail": payload.SendCreationEmail__c as Boolean default false
  
}
]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="D2L Request Logger" doc:id="feca9484-0e17-46eb-9b3a-80fd255661e7" message="#[payload]"/>
