#%RAML 1.0 DataType
type: object
properties:
  PagingInfo:
    type: object
    properties:
      Bookmark?: string
      HasMoreItems: boolean
  Items:
    type: array
    items:
      type: object
      properties:
        Identifier: string
        Name: string
        Code: string
        Type:
          type: object
          properties:
            Id: integer
            Code: string
            Name: string
        OrgUnitPath: string
