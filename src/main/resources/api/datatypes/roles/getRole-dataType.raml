#%RAML 1.0 DataType
type: object
properties:
  Identifier:
    type: string
    description: Unique identifier of the role
    example: "ROLE_001"
  DisplayName:
    type: string
    description: Display name of the role
    example: "Instructor"
  Code:
    type: string
    description: Short code representing the role
    example: "INST"
  Description?:
    type: string
    description: Description of the role (available in LP's unstable contract)
    example: "Instructor role with full permissions"
  RoleAlias?:
    type: string
    description: Alias for the role (available in LP's unstable contract)
    example: "Teacher"
  IsCascading?:
    type: boolean
    description: Whether the role cascades to sub-entities (available in LP's unstable contract)
    example: true
  AccessFutureCourses?:
    type: boolean
    description: Whether the role allows access to future courses (available in LP's unstable contract)
    example: true
  AccessInactiveCourses?:
    type: boolean
    description: Whether the role allows access to inactive courses (available in LP's unstable contract)
    example: false
  AccessPastCourses?:
    type: boolean
    description: Whether the role allows access to past courses (available in LP's unstable contract)
    example: true
  ShowInGrades?:
    type: boolean
    description: Whether the role is visible in grades (available in LP's unstable contract)
    example: true
  ShowInUserProgress?:
    type: boolean
    description: Whether the role is visible in user progress (available in LP's unstable contract)
    example: true
  InClassList?:
    type: boolean
    description: Whether the role appears in the class list (available in LP's unstable contract)
    example: true
