#%RAML 1.0 DataType
type: object
properties:
  OrgDefinedId: string
  FirstName: string
  MiddleName?: string | nil
  LastName: string
  ExternalEmail?: string | nil
  UserName: string
  Activation:
    type: object
    properties:
      IsActive: boolean
      StartDate?: string
      EndDate?: string
  Pronouns?: string | nil
