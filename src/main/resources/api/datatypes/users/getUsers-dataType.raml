#%RAML 1.0 DataType
type: object
properties:
  OrgId: integer
  UserId: integer
  FirstName: string
  MiddleName?: string | nil
  LastName: string
  UserName: string
  ExternalEmail?: string | nil
  OrgDefinedId?: string | nil
  UniqueIdentifier?: string
  Activation:
    type: object
    properties:
      IsActive: boolean
      StartDate?: datetime
      EndDate?: datetime | nil
  DisplayName?: string
  LastAccessedDate?: datetime | nil
  Pronouns?: string
