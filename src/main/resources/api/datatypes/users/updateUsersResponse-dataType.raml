#%RAML 1.0 DataType
type: object
properties:
  OrgId: integer
  UserId: integer
  FirstName: string
  MiddleName?: string | nil
  LastName: string
  UserName: string
  ExternalEmail?: string | nil
  OrgDefinedId?: string | nil
  UniqueIdentifier: string
  Activation:
    type: object
    properties:
      IsActive: boolean
      StartDate?: string
      EndDate?: string
  DisplayName: string
  LastAccessedDate?: string | nil
  Pronouns: string
