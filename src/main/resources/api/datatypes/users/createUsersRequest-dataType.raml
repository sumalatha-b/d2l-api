#%RAML 1.0 DataType
type: object
properties:
  newUsers:
    type: array
    items:
      type: object
      properties:
        FirstName: string
        MiddleName?: string
        LastName: string
        UserName: string
        ExternalEmail?: string
        OrgDefinedId?: string
        UniqueIdentifier: string
        Activation?:
          type: object
          properties:
            StartDate: string
            EndDate?: string
            IsActive: boolean
