#%RAML 1.0 DataType
type: object
properties:
  DisplayedGrade: string
  GradeObjectIdentifier: string
  GradeObjectName: string
  GradeObjectType: integer
  GradeObjectTypeName?:
    type: string
    description: May be null if type name is not provided
  Comments?:
    type: object
    properties:
      Text?: string
      Html?: string
  PrivateComments?:
    type: object
    properties:
      Text: string
      Html: string
  LastModified?:
    type: datetime
    description: May be null
  LastModifiedBy?:
    type: string
    description: May be null
  ReleasedDate?:
    type: datetime
    description: May be null
