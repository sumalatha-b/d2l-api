#%RAML 1.0
title: D2L
version: v1
baseUri:  https://nexturn.d2l-partners.brightspace.com/d2l/api
description: D2L LMS is a cloud-based learning management system that allows educators to create and manage courses, assignments, quizzes, and student communication in a flexible and user-friendly platform.
protocols: [ HTTPS ]
mediaType: application/json

traits:
  errorResponse: !include /traits/errorResponse-trait.raml
  commonHeaders: !include /traits/commonHeaders-trait.raml
types:
  getUsers: !include /datatypes/users/getUsers-dataType.raml
  classListUser: !include /datatypes/roles/classListUser-dataType.raml
  orgUnitEnrollments: !include /datatypes/orgUnit/orgUnitEnrollments-dataType.raml
  userEnrollment: !include /datatypes/users/userEnrollment-dataType.raml
  userOrgUnitsEnrollments: !include /datatypes/orgUnit/userOrgUnitsEnrollments-dataType.raml
  orgUnitId: !include /datatypes/orgUnit/orgUnitId-dataType.raml
  getChildrenPagedResponse: !include /datatypes/roles/getChildrenPagedResponse-dataType.raml
  CourseOfferingResponse: !include /datatypes/courseOffering/courseOfferingResponse-dataType.raml
  CourseTemplateResponse: !include /datatypes/courseTemplate/getCourseTemplateResponse-dataType.raml
  GradeObjectResponse: !include /datatypes/grades/gradeObjectResponse-dataType.raml
  createUser: !include /datatypes/users/createUser-dataType.raml
  createUsersRequest: !include /datatypes/users/createUsersRequest-dataType.raml
  createUsersResponse: !include /datatypes/users/createUsersResponse-dataType.raml
  UserResetPassword: !include /datatypes/users/userResetPassword-dataType.raml
  RoleCopyRequest: !include /datatypes/roles/createRolesRequest-dataType.raml
  RoleCopyRsponse: !include /datatypes/roles/createRolesResponse-dataType.raml
  createEnrollmentRequest: !include /datatypes/enrollment/createEnrollmentdataRequest-dataType.raml
  createEnrollmentResponse: !include /datatypes/enrollment/createEnrollmentdataResponse-dataType.raml
  batchEnrollmentRequest:  !include /datatypes/enrollment/batchEnrollmentsRequest-dataType.raml
  batchEnrollmentResponse: !include /datatypes/enrollment/batchEnrollmentsResponse-dataType.raml
  getRoles: !include /datatypes/roles/getRoles-dataType.raml
  getUserAttributes: !include /datatypes/userAttributes/getUserAttributes-datatype.raml
  getUsersFinalGrades: !include /datatypes/grades/getUsersFinalGrades-dataType.raml
  getGradesByUser: !include /datatypes/grades/getGradesByUser-dataType.raml
  getCourseCompletion: !include /datatypes/course/getCourseCompletion-dataType.raml
  updateUsersRequest: !include /datatypes/users/updateUsersRequest-dataType.raml
  updateUsersResponse: !include /datatypes/users/updateUsersResponse-dataType.raml
  updateUserAttributes: !include /datatypes/userAttributes/updateUserAttributes-datatype.raml
  updateOrgUnit: !include /datatypes/orgUnit/updateOrgUnit-dataType.raml
  OrgUnitTypeInfo: !include /datatypes/orgUnit/orgUnitTypeInfo-dataType.raml
  updateCourseOffering: !include /datatypes/courseOffering/updateCourseOffering-dataType.raml
  updateCourseTemplate: !include /datatypes/courseTemplate/updateCourseTemplate-dataType.raml
  deleteEnrollment: !include /datatypes/enrollment/deleteEnrollment-dataType.raml
  commonResponse: !include /datatypes/common/common-dataType.raml
  orgUnitCreateData: !include /datatypes/orgStructure/createOrgUnitDataRequest-dataType.raml
  orgUnit: !include /datatypes/orgStructure/createOrgUnitResponse-dataType.raml
  addParentOrgUnit: !include /datatypes/orgStructure/addParentOrgUnit-datatype.raml
  addChildOrgUnit: !include /datatypes/orgStructure/addChildOrgUnit-datatype.raml
  reqCreateCourseOffering: !include /datatypes/courseOffering/createCourseOfferingRequest-datatype.raml
  resCreateCourseOffering: !include /datatypes/courseOffering/creatCourseOfferingResponse-datatype.raml
  reqCreateCourseTemplate: !include /datatypes/courseTemplate/createCourseTemplateRequest-datatype.raml
  resCourseTemplate: !include /datatypes/courseTemplate/createCourseTemplateResponse-dataType.raml
  getStudentActivity: !include /datatypes/events/getStudentActivity-dataType.raml
  getAssignmentGroups: !include /datatypes/assignmentGroups/getAssignnmentGroups-dataType.raml
  userResetPasswordResponse: !include /datatypes/users/userResetPasswordResponse-dataType.raml

/lp/{version}/users/:
  uriParameters:
    version:
      description: API version (D2LVERSION)
      type: any
      required: true
      example: 1.28
  get:
    is: [commonHeaders,errorResponse]
    displayName: User - Get users
    description: Get users
    queryParameters:
      orgDefinedId?: string
      userName?: string
      externalEmail?: string
      bookmark?: string
    responses:
      200:
        body:
          application/json:
            type: getUsers
            example: !include /examples/users/getUsers-example.json
  post:
    is: [commonHeaders,errorResponse]
    displayName: User - Create User
    description: Create a new user entity.
    body:
      application/json:
        type: createUser
        example: !include /examples/users/createUserRequest-example.json
    responses:
      200:
        body:
          application/json:
            type: createUser
            example: !include /examples/users/createUserResponse-example.json
/le/{version}/{orgUnitId}/classlist/:
  uriParameters:
    version:
      description: API version (D2LVERSION)
      type: any
      required: true
      example: 1.28
    orgUnitId:
      type: string
      required: true
      example: "12345"
  get:
    is: [commonHeaders,errorResponse]
    displayName: Enrollment - Get classlist by orgunit
    description: Retrieve the enrolled users in the classlist for an org unit.
    responses:
      200:
        body:
          application/json:
            type: classListUser[]
            examples:
              example1: !include /examples/roles/getClassList-example.json

/lp/{version}/enrollments/orgUnits/{orgUnitId}/users/:
  uriParameters:
    version:
      description: API version (D2LVERSION)
      type: any
      required: true
      example: 1.28
    orgUnitId:
      type: string
      required: true
      example: "12345"
  get:
    is: [commonHeaders,errorResponse]
    displayName: Enrollment - Get enrollments by orgunit
    description: Retrieve the collection of users enrolled in the identified org unit.
    queryParameters:
      roleId?:
        type: integer
        description: Filter list to a specific user role.
        example: 101
      isActive?:
        type: boolean
        description: Filter list to only active or inactive users.
        example: true
      bookmark?:
        type: string
        description: Bookmark to use for fetching next data set segment.
        example: "abc123"
    responses:
      200:
        body:
          application/json:
            type: orgUnitEnrollments
            examples:
              success: !include /examples/orgUnit/getOrgUnitEnrollments-example.json
/lp/{version}/enrollments/orgUnits/{orgUnitId}/users/{userId}:
  uriParameters:
    version:
      description: API version (D2LVERSION)
      type: any
      required: true
      example: 1.28
    orgUnitId:
      type: string
      required: true
      example: "12345"
    userId:
      type: string
      required: true
      example: "67890"
  get:
    is: [commonHeaders,errorResponse]
    displayName: Enrollment - Get enrollment by orgunit
    description: Retrieve enrollment details for a user in the provided org unit.
    responses:
      200:
        body:
          application/json:
            type: userEnrollment
            examples:
              success: !include /examples/users/getUserEnrollment-example.json
  delete:
    is: [commonHeaders,errorResponse]
    displayName: Enrollment - Delete enrollment by orgunit
    responses:
      200:
        body:
          application/json:
            type: commonResponse
            example: !include /examples/common/common-example.json
/lp/{version}/enrollments/users/{userId}/orgUnits/:
  uriParameters:
    version:
      description: API version (D2LVERSION)
      type: any
      required: true
      example: 1.28
    userId:
      type: string
      required: true
      example: "67890"
  get:
    is: [commonHeaders,errorResponse]
    displayName: Enrollment - Get user's enrollments
    description: Retrieve a list of all enrollments for the provided user.
    queryParameters:
      orgUnitTypeId?:
        type: string
        description: CSV of D2LIDs – Filter list to specific org unit types.
      roleId?:
        type: integer
        description: Filter list to a specific user role.
      bookmark?:
        type: string
        description: Paging bookmark.
    responses:
      200:
        body:
          application/json:
            type: userOrgUnitsEnrollments
            examples:
              success: !include /examples/orgUnit/getUserOrgUnitsEnrollments-example.json
 
/lp/{version}/orgstructure/{orgUnitId}:
  uriParameters:
    version:
      description: API version (D2LVERSION)
      type: any
      required: true
      example: 1.28
    orgUnitId:
      type: string
      required: true
      example: "1001"
  get:
    is: [commonHeaders,errorResponse]
    displayName: Orgunit - Get orgunit
    description: Retrieve the properties for a provided org unit.
    responses:
      200:
        body:
          application/json:
            type: orgUnitId
            examples:
              success: !include /examples/orgUnit/getOrgUnitId-example.json
  put:
    is: [commonHeaders,errorResponse]
    displayName: Orgunit - Update orgunit
    body:
      application/json:
        type: updateOrgUnit
        example: !include /examples/orgUnit/updateOrgUnit-example.json
    responses:
      200:
        body:
          application/json:
            type: updateOrgUnit
            example: !include /examples/orgUnit/updateOrgUnit-example.json

/lp/{version}/orgstructure/{orgUnitId}/children/paged/:
  uriParameters:
    version:
      description: API version (D2LVERSION)
      type: any
      required: true
      example: 1.28
    orgUnitId:
      description: Org Unit ID (D2LID)
      type: string
      required: true
      example: "12345"
  get:
    is: [commonHeaders,errorResponse]
    displayName: Orgunit - Get orgunit children
    description: Retrieve a list of child-units for a provided org unit.
    queryParameters:
      ouTypeId?:
        description: Filter retrieved list by this org unit type
        type: string
        example: "678"
      bookmark?:
        description: Bookmark to use for fetching the next data set segment
        type: string
        example: "abc123"
    responses:
      200:
        body:
          application/json:
            type: getChildrenPagedResponse
            example: !include /examples/roles/getChildrenPagedResponse-example.json

/lp/{version}/courses/{orgUnitId}:
  uriParameters:
    version:
      description: API version (D2LVERSION)
      type: any
      required: true
      example: 1.28
    orgUnitId:
      description: Org Unit ID (D2LID)
      type: string
      required: true
      example: "12345"
  get:
    is: [commonHeaders,errorResponse]
    displayName: Course Offering - Get course offering
    description: Retrieve a course offering.
    responses:
      200:
        body:
          application/json:
            type: CourseOfferingResponse
            example: !include /examples/courseOffering/getCourseOfferingResponse-example.json
  put:
    is: [commonHeaders,errorResponse]
    displayName: Course Offering - Update course offering
    body:
      application/json:
        type: updateCourseOffering
        example: !include /examples/courseOffering/updateCourseOffering-example.json
    responses:
      200:
        body:
          application/json:
            type: updateCourseOffering
            example: !include /examples/courseOffering/updateCourseOffering-example.json
  delete:
    is: [commonHeaders,errorResponse]
    displayName: Course Offering - Delete Course Offering
    description: Delete a course offering.
    responses:
      200:
        body:
          application/json:
            type: commonResponse
            example: !include /examples/common/common-example.json
/lp/{version}/coursetemplates/{orgUnitId}:
  uriParameters:
    version:
      description: API version (D2LVERSION)
      type: any
      required: true
      example: 1.28
    orgUnitId:
      description: Org Unit ID (D2LID)
      type: string
      required: true
      example: "98765"
  get:
    is: [commonHeaders,errorResponse]
    displayName: Course Template - Get course template
    description: Retrieve a course template.
    responses:
      200:
        body:
          application/json:
            type: CourseTemplateResponse
            example: !include /examples/courseTemplate/getCourseTemplateResponse-example.json
  put:
    is: [commonHeaders,errorResponse]
    displayName: Course Template -Update course template
    body:
      application/json:
        type: updateCourseTemplate
        example: !include /examples/courseTemplate/updateCourseTemplate-example.json
    responses:
      200:
        body:
          application/json:
            type: updateCourseTemplate
            example: !include /examples/courseTemplate/updateCourseTemplate-example.json
  delete:
    is: [commonHeaders,errorResponse]
    displayName: Course Template - Delete course template
    description: Delete a course template.
    responses:
      200:
        body:
          application/json:
            type: commonResponse
            example: !include /examples/common/common-example.json
/le/{version}/{orgUnitId}/grades/{gradeObjectId}:
  uriParameters:
    version:
      description: API version (D2LVERSION)
      type: any
      required: true
      example: 2.5
    orgUnitId:
      description: Org Unit ID (D2LID)
      type: string
      required: true
      example: "1234"
    gradeObjectId:
      description: Grade Object ID (D2LID)
      type: string
      required: true
      example: "5678"
  get:
    is: [commonHeaders,errorResponse]
    displayName: Grades - Get grade object
    description: Retrieve a specific grade object for a particular org unit.
    responses:
      200:
        body:
          application/json:
            type: GradeObjectResponse
            example: !include /examples/grades/getGradeObjectResponse-example.json


/lp/{version}/orgstructure/{orgUnitId}/ancestors/paged/:
  uriParameters:
    version:
      description: API version (D2LVERSION)
      type: any
      required: true
      example: 1.28
    orgUnitId:
      description: Org Unit ID (D2LID)
      type: string
      required: true
      example: "12345"
  get:
    is: [commonHeaders,errorResponse]
    displayName: Orgunit - Get orgunit ancestors
    description: Retrieve a list of ancestor org units for a provided org unit.
    queryParameters:
      ouTypeId:
        description: Filter retrieved list by this org unit type
        type: string
        required: false
        example: "678"
      bookmark:
        description: Bookmark to use for fetching the next data set segment
        type: string
        required: false
        example: "abc123"
    responses:
      200:
        body:
          application/json:
            type: getChildrenPagedResponse
            example: !include /examples/roles/getChildrenPagedResponse-example.json


/lp/{version}/users/batch/:
  uriParameters:
    version:
      description: API version (D2LVERSION)
      type: any
      required: true
      example: 1.28
  post:
    is: [commonHeaders,errorResponse]
    displayName: User - Create users
    description: Create multiple new user entities (max 500)
    body:
      application/json:
        type: createUsersRequest
        example: !include /examples/users/createUsersRequest-example.json
    responses:
      201:
        description: At least one user created
        body:
          application/json:
            type: createUsersResponse
            example: !include /examples/users/createUsersResponse-example.json

/lp/{version}/users/{userId}/password:
  uriParameters:
    version:
      description: API version (D2LVERSION)
      type: any
      required: true
      example: 1.28
    userId:
      type: string
      required: true
      example: "67890"
      description: User ID
    
  post:
    is: [commonHeaders,errorResponse]
    displayName: User - Send password reset
    description: Send a password reset email to a particular user.
    body:
      application/json:
        type: UserResetPassword
        example: !include /examples/users/userResetPasswordRequest-example.json
    responses:
      200:
        description: Password reset email sent successfully
        body:
          application/json:
            type: userResetPasswordResponse
            example: !include /examples/users/userResetPasswordResponse-example.json

/lp/{version}/roles/:
  uriParameters:
    version:
      description: API version (D2LVERSION)
      type: any
      required: true
      example: 1.28
  post:
    is: [commonHeaders,errorResponse]
    displayName: Roles - Create Role
    queryParameters:
      deepCopyRoleId?:
        type: string
    body:
      application/json:
        type: RoleCopyRequest
        example: !include /examples/roles/createRoleRequest-example.json
    responses:
      200:
        body:
          application/json:
            type: RoleCopyRsponse
            example: !include /examples/roles/createRoleResponse-example.json

/lp/{version}/enrollments/:
  uriParameters:
    version:
      description: API version (D2LVERSION)
      type: any
      required: true
      example: 1.28
  post:
    is: [commonHeaders,errorResponse]
    displayName: Enrollment - Create enrollment
    description: Create a new enrollment or update an existing one.
    body:
      application/json:
        type: createEnrollmentRequest
        example: !include /examples/enrollment/createEnrollmentRequest-example.json
    responses:
      200:
        description: Enrollment created or updated successfully
        body:
          application/json:
            type: createEnrollmentResponse
            example: !include /examples/enrollment/createEnrollmentResponse-example.json


/lp/{version}/enrollments/batch/:
  uriParameters:
    version:
      description: API version (D2LVERSION)
      type: any
      required: true
      example: 1.28
  post:
    is: [commonHeaders,errorResponse]
    displayName: Enrollment - Create enrollments
    description: Create or update multiple enrollments (max 1000 per batch).
    body:
      application/json:
        type: batchEnrollmentRequest           
        example: !include /examples/enrollment/batchEnrollmentsRequest-example.json
    responses:
      201:
        description: At least one enrollment created
        body:
          application/json:
            type: array
            items: batchEnrollmentResponse
            example: !include /examples/enrollment/batchEnrollmentsResponse-example.json
/lp/{version}/users/{userId}:
  uriParameters: 
    version:
      description: API version (D2LVERSION)
      type: any
      required: true
      example: 1.28
    userId: string
  get:
    is: [commonHeaders,errorResponse]
    displayName: User - Get user
    description: Get user
    responses:
      200:
        body:
          application/json:
            type: getUsers
            example: !include /examples/users/getUsers-example.json
  put:
    is: [commonHeaders,errorResponse]
    displayName: User - Update user
    description: Update data for a particular user.
    body:
      application/json:
        type: updateUsersRequest
        example: !include /examples/users/updateUsersRequest-example.json
    responses:
      200:
        body:
          application/json:
            type: updateUsersResponse
            example: !include /examples/users/updateUsersResponse-example.json
  delete:
    is: [commonHeaders,errorResponse]
    displayName: User - Delete User
    description: Delete a particular user.  
    responses:
      200:
        body:
          application/json:
            type: commonResponse
            example: !include /examples/common/common-example.json
