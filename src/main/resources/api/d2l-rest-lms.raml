  uriParameters: 
    version:
      description: API version (D2LVERSION)
      type: any
      required: true
      example: 1.28
    orgUnitId: string
    gradeObjectId: string
  get:
    is: [commonHeaders,errorResponse]
    displayName: Grades - Get users' grades by grade object
    description: Get users grades by grade object
    queryParameters:
      sort?: string
      pageSize?: integer
      isGraded?: boolean
