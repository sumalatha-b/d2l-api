/le/{version}/{orgUnitId}/grades/final/values/:
  uriParameters: 
    version:
      description: API version (D2LVERSION)
      type: any
      required: true
      example: 1.28
    orgUnitId: string
  get:
    is: [commonHeaders,errorResponse]
    displayName: Grades - Get users' final grades
    description: Get users final grades
    queryParameters:
      sort?: string
      pageSize?: integer
      isGraded?: boolean
      searchText?: string
    responses:
      200:
        body:
          application/json:
            type: getUsersFinalGrades
            example: !include /examples/grades/getUsersFinalGrades-example.json

/le/{version}/{orgUnitId}/grades/final/values/{userId}:           
  uriParameters: 
    version:
      description: API version (D2LVERSION)
      type: any
      required: true
      example: 2.5
    orgUnitId: string
    userId: string
  get:
    is: [commonHeaders,errorResponse]
    displayName: Grades - Get user's final grades
    description: Get grades by user
    queryParameters:
      gradeType?: string
    responses:
      200:
        body:
          application/json:
            type: getGradesByUser
